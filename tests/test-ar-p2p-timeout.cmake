execute_process(COMMAND "${TEST_EXE}" --timeout RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if ("${result}" STREQUAL "77")
    message("SKIP: graph-recordable P2P AllReduce unavailable")
    return()
endif()
if ("${result}" STREQUAL "0" OR "${result}" MATCHES "[Tt]imeout|[Tt]imed out")
    message(FATAL_ERROR "Missing peer did not fail within the kernel deadline: ${result}\n${output}\n${error}")
endif()
if (NOT "${output}${error}" MATCHES "peer missed AllReduce epoch")
    message(FATAL_ERROR "Process failed without the epoch-timeout diagnostic: ${result}\n${output}\n${error}")
endif()
