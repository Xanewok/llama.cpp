 ggml/src/ggml-cuda/fattn-mma-f16.cuh | 133 ++++++++++++++++++---------
 1 file changed, 90 insertions(+), 43 deletions(-)

diff --git a/ggml/src/ggml-cuda/fattn-mma-f16.cuh b/ggml/src/ggml-cuda/fattn-mma-f16.cuh
index 0f9b833f4..829c03638 100644
