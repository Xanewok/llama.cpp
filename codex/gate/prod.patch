    spec : reset the MTP hidden-state carry when a sequence starts anew
    
    pending_h pairs the first token of a catch-up batch with the target hidden
    state of the token before it. It was kept across requests, so the first draft
    K/V row of a new request on a reused sequence held the last hidden state of
    the previous request. Use a zero row, as on a fresh context, when the draft
    memory of the sequence is empty.

diff --git a/common/speculative.cpp b/common/speculative.cpp
index c5043a4a8..d52e860a8 100644
--- a/common/speculative.cpp
+++ b/common/speculative.cpp
@@ -1569,6 +1569,14 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
 
         // if kv is shared with target (e.g Gemma4), then we can skip this catch-up decode
         if (!is_mem_shared) {
+            // an empty draft memory means the sequence starts anew (e.g. a new request on a reused slot):
+            // nothing precedes its first token, so the last row of the previous run must not be carried
+            for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
+                if (i_batch_beg[seq_id] >= 0 && llama_memory_seq_pos_max(llama_get_memory(ctx_dft), seq_id) < 0) {
+                    std::fill(pending_h[seq_id].begin(), pending_h[seq_id].end(), 0.0f);
+                }
+            }
+
             batch.clear();
 
