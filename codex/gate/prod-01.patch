Author: Igor Matuszewski <xanewok@gmail.com>
Date:   Sat Oct 10 20:37:39 2026 +0200

    sampling : map backend logit_bias through candidates
    
    When an earlier backend sampler has set candidates, logit_bias wrote the
    bias by vocab id into a tensor sized like the candidates. With top-k it
    aborted (out-of-range set_rows, and a [1,k] logits shape mismatch in
    add); with top-p the bias landed on the wrong entries.
    
    Build the bias over the vocab and gather it with the candidates. Add a
    test-backend-sampler case for top-k and top-p followed by logit_bias.

diff --git a/src/llama-sampler.cpp b/src/llama-sampler.cpp
index 59fafd938..a030e537c 100644
--- a/src/llama-sampler.cpp
+++ b/src/llama-sampler.cpp
@@ -3990,11 +3990,17 @@ static void llama_sampler_logit_bias_backend_apply(
         ggml_set_input(sctx->inp_logit_idxs);
     }
 
-    ggml_tensor * cur = ggml_fill(ctx, data->logits, 0.0f);
+    // the bias is indexed by vocab id, so with candidates build it over the vocab and gather it
+    ggml_tensor * cur = ggml_fill(ctx, data->candidates ? ggml_new_tensor_1d(ctx, GGML_TYPE_F32, sctx->n_vocab) : data->logits, 0.0f);
 
     cur = ggml_reshape_2d(ctx, cur, 1, ggml_nelements(cur));
     cur = ggml_set_rows(ctx, cur, sctx->inp_logit_bias, sctx->inp_logit_idxs);
-    cur = ggml_reshape_1d(ctx, cur, ggml_nelements(cur));
+
+    if (data->candidates) {
+        cur = ggml_get_rows(ctx, cur, ggml_reshape_1d(ctx, data->candidates, ggml_nelements(data->candidates)));
+    }
+
+    cur = ggml_reshape(ctx, cur, data->logits);
 
     data->logits = ggml_add(ctx, data->logits, cur);
 }
