id = "gdn4-cuda-checks"
title = "GDN four state columns per warp (#30087) on stack8, test-backend-ops on both RTX 5060 Ti: NMSE correctness vs CPU, mutant must fail, perf stack8 vs candidate at the 48-head decode and verify shapes"
# Canary (G ~90 s): candidate passes and the reduction mutant fails GATED_DELTA_NET head_count=4 on GPU 0.
# Run (G ~20 min): correctness of GATED_DELTA_NET, _INDEXED, _CACHE_FUSION, _INDEXED_CACHE_FUSION on cand (both GPUs) and base (GPU 0), mutant (GPU 0), then 4 ABBA rounds x 2 GPUs x 2 perf selections.
# Expected: PASS; mutant caught (G). Perf (D, from #30087 on a 4090: -12 % at n=1, -33 % multi-token): negative delta on head_count=24 decode and verify shapes, unmeasured on sm_120;
# kernel time in serving ~0.63 ms/round (M), so a -20..-30 % delta predicts about -0.2 ms/round.
# Identity: base and cand outputs differ bitwise (reduction width 32 -> 8): the gate is the test's NMSE tolerance against the CPU backend, with base passing the same cases and the mutant failing them.
priority = 29
kind = "measure"
host_sensitive = false
budget_s = 3600
est_s = 1500
ab = false
retry = "fresh"
exit_codes = { "3" = "hazard", "4" = "transient", "5" = "insufficient_data", "6" = "integrity", "7" = "timeout", "8" = "deterministic" }
signatures = [
  { class = "hazard", regex = "\\bXid\\b|fallen off the bus" },
  { class = "integrity", regex = "bytes changed|unresolved libraries|resolve outside|lacks the four-column kernel|carries the four-column kernel|is not an RTX 5060 Ti" },
  { class = "insufficient_data", regex = "mutant passed" },
  { class = "timeout", regex = "budget expired|hung \\(600 s\\)" },
]

[run]
cmd = ["bash", "/home/xanewok/repos/qwen38-eval-worktrees/work/aa-load/ccx01.sh", "bash", "@ROOT@/codex/gdn4/cuda/cuda-checks.sh", "--run"]
cwd = "@ROOT@"
env = { COMMIT = "@COMMIT@", BUDGET_S = "3000", OUT = "/home/xanewok/repos/qwen38-eval/results/@DATE@-gdn4-cuda-checks/a{attempt}" }
ports = []

[preflight]
cmd = ["bash", "@ROOT@/codex/gdn4/cuda/cuda-checks.sh", "--preflight"]
env = { COMMIT = "@COMMIT@", OUT = "/home/xanewok/repos/qwen38-eval/results/@DATE@-gdn4-cuda-checks/preflight" }
timeout_s = 120

[canary]
cmd = ["bash", "/home/xanewok/repos/qwen38-eval-worktrees/work/aa-load/ccx01.sh", "bash", "@ROOT@/codex/gdn4/cuda/cuda-checks.sh", "--canary"]
env = { COMMIT = "@COMMIT@", BUDGET_S = "500", OUT = "/home/xanewok/repos/qwen38-eval/results/@DATE@-gdn4-cuda-checks/canary-a{attempt}" }
timeout_s = 600

[outputs]
paths = ["/home/xanewok/repos/qwen38-eval/results/@DATE@-gdn4-cuda-checks/a{attempt}"]

[fix]
editable = []
protected = ["frozen", "budget"]

[pins]
files = [
  "/home/xanewok/repos/qwen38-eval-worktrees/work/aa-load/ccx01.sh",
  "@ROOT@/codex/gdn4/cuda/cuda-checks.sh",
  "@ROOT@/codex/gdn4/cuda/perf_summary.py",
  "/home/xanewok/repos/qwen38-eval-worktrees/frozen/gdn-4col-s8/SOURCE",
@BIN_PINS@
]
