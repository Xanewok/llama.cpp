+trap 'printf "%s\n" "$?" > "$TASK/verify.rc"' EXIT
+export S7_GATE=$TASK/mac-model-gate.sh GPUQ_BUILD_WINDOW=1
+export S7_MODEL=$HOME/qwen38-stack7/models/Qwen3.5-4B-UD-Q4_K_XL.gguf
