From aecbf85971b984f76b07393caa5a1f5a08ae0014 Mon Sep 17 00:00:00 2001
From: Igor Matuszewski <xanewok@gmail.com>
Date: Wed, 7 Oct 2026 14:54:00 +0200
Subject: [PATCH] speculative : draft the MTP steps of a round in one decode

---
 common/arg.cpp         |  9 +++++++++
 common/common.h        |  2 ++
 common/speculative.cpp | 41 ++++++++++++++++++++++++++++++++++-------
 src/llama-model.cpp    |  6 +++++-
 src/llama-sampler.cpp  | 14 ++++++++++++--
 5 files changed, 62 insertions(+), 10 deletions(-)

diff --git a/common/arg.cpp b/common/arg.cpp
index bd7d57327..1cd1e3b2f 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -4257,6 +4257,15 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
             }
         }
     ).set_spec().set_examples({LLAMA_EXAMPLE_SPECULATIVE, LLAMA_EXAMPLE_SERVER, LLAMA_EXAMPLE_CLI}).set_env("LLAMA_ARG_SPEC_DRAFT_SAMPLING"));
+    add_opt(common_arg(
+        {"--spec-mtp-chain"},
+        "draft-mtp: run the draft steps of a round as one graph that feeds each sampled token to the next step on "
+        "the device; needs --spec-draft-sampling probabilistic, --spec-draft-p-min 0 and a --spec-draft-vocab "
+        "(default: disabled)",
+        [](common_params & params) {
+            params.speculative.draft.mtp_chain = true;
+        }
+    ).set_spec().set_examples({LLAMA_EXAMPLE_SPECULATIVE, LLAMA_EXAMPLE_SERVER, LLAMA_EXAMPLE_CLI}).set_env("LLAMA_MTP_CHAIN"));
     add_opt(common_arg(
         {"--spec-draft-device", "-devd", "--device-draft"}, "<dev1,dev2,..>",
         "comma-separated list of devices to use for offloading the draft model (none = don't offload, default: follows --device)\n"
diff --git a/common/common.h b/common/common.h
index 7b5ec1715..05ad10750 100644
--- a/common/common.h
+++ b/common/common.h
@@ -338,6 +338,8 @@ struct common_params_speculative_draft {
 
     bool probabilistic = false; // sample the draft and verify by rejection, instead of argmax and match
 
+    bool mtp_chain = false; // draft-mtp: draft all steps of a round in one device-side graph, see llama_set_mtp_chain
+
     common_params_model mparams;
 
     llama_context * ctx_tgt = nullptr;
diff --git a/common/speculative.cpp b/common/speculative.cpp
index aac8724f9..90dc0b1b8 100644
--- a/common/speculative.cpp
+++ b/common/speculative.cpp
@@ -15,6 +15,8 @@
 #include <algorithm>
 #include <cassert>
 #include <cmath>
+#include <cstdio>
+#include <cstdlib>
 #include <cstring>
 #include <iomanip>
 #include <map>
@@ -1435,8 +1437,25 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
     };
     std::vector<mtp_chain_seq> mtp_chain_seqs;
 
+    // LLAMA_MTP_CHAIN_DUMP=path: one line per drafted token, "round step id cand_ids[10] probs[10]", chain or not
+    FILE * mtp_chain_dump = nullptr;
+    int    mtp_chain_round = 0;
+
+    void mtp_chain_dump_step(int step, llama_token id, const llama_token_data_array * cur_p) {
+        if (!mtp_chain_dump) {
+            return;
+        }
+        std::fprintf(mtp_chain_dump, "%d %d %d", mtp_chain_round, step, id);
+        for (size_t i = 0; i < 10; ++i) {
+            std::fprintf(mtp_chain_dump, " %d", i < cur_p->size ? cur_p->data[i].id : -1);
+        }
+        for (size_t i = 0; i < 10; ++i) {
+            std::fprintf(mtp_chain_dump, " %.9g", i < cur_p->size ? cur_p->data[i].p : 0.0f);
+        }
+        std::fprintf(mtp_chain_dump, "\n");
+        std::fflush(mtp_chain_dump);
+    }
     std::vector<float>         mtp_chain_zeros; // h of the rows past step 0, which the chain replaces
-    bool mtp_chain = true;
     bool mtp_chain_announced = false;
 
     common_speculative_impl_draft_mtp(const common_params_speculative & params, uint32_t n_seq)
@@ -1509,6 +1528,9 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
 
         mtp_chain_seqs.resize(n_seq);
         mtp_chain_zeros.assign(n_embd, 0.0f);
+        if (const char * path = std::getenv("LLAMA_MTP_CHAIN_DUMP")) {
+            mtp_chain_dump = std::fopen(path, "w");
+        }
 
         i_last.assign(n_seq, -1);
         i_batch_beg.assign(n_seq, -1);
@@ -1534,6 +1556,9 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
         for (auto & c : mtp_chain_seqs) {
             llama_sampler_free(c.smpl);
         }
+        if (mtp_chain_dump) {
+            std::fclose(mtp_chain_dump);
+        }
     }
 
     void begin(llama_seq_id seq_id, const llama_tokens & prompt) override {
@@ -1740,7 +1765,7 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
 
         llama_seq_id seq_id = -1;
         // The chain graph requires one attached sampler; idle slots keep their samplers.
-        bool eligible = mtp_chain && n_seq == 1 && !chain_heads && !is_mem_shared && params.p_min <= 0.0f &&
+        bool eligible = params.mtp_chain && n_seq == 1 && !chain_heads && !is_mem_shared && params.p_min <= 0.0f &&
                 params.probabilistic && params.backend_sampling && k >= 2 && k <= LLAMA_MTP_CHAIN_MAX;
         for (llama_seq_id s = 0; eligible && s < (llama_seq_id) n_seq; ++s) {
             if (dparams[s].drafting) {
@@ -1752,7 +1777,7 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
 
         if (eligible && !mtp_chain_attach(seq_id, dparams[seq_id].temp, dparams[seq_id].seed)) {
             SPC_WRN("%s", "the draft context does not take the MTP chain's sampler; drafting step by step\n");
-            mtp_chain = false;
+            params.mtp_chain = false;
             eligible = false;
         }
         for (llama_seq_id s = 0; s < (llama_seq_id) n_seq; ++s) {
@@ -1775,7 +1800,7 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
 
         if (!llama_set_mtp_chain(ctx_dft, k)) {
             SPC_WRN("%s", "the draft context cannot run the MTP chain; drafting step by step\n");
-            mtp_chain = false;
+            params.mtp_chain = false;
             mtp_chain_release(seq_id);
             batch.clear();
             return false;
@@ -1798,6 +1823,7 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
 
             const auto * cur_p = common_sampler_get_candidates(smpl, true);
 
+            mtp_chain_dump_step(s, id, cur_p);
             common_sampler_accept(smpl, id, true);
             // commits the uniform behind this token, or the next round draws it again
             llama_sampler_accept(mtp_chain_seqs[seq_id].smpl, id);
@@ -1810,6 +1836,7 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
     }
 
     void draft(common_speculative_draft_params_vec & dparams) override {
+        ++mtp_chain_round;
         if (draft_chain(dparams)) {
             return;
         }
@@ -1907,6 +1934,8 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
                 // add drafted token for each sequence
                 const llama_token id = dparams.at(seq_id).result_q ? id_sampled : cur_p->data[0].id;
 
+                mtp_chain_dump_step(i, id, cur_p);
+
                 // only collect very high-confidence draft tokens
                 if (cur_p->data[0].p < params.p_min) {
                     drafting[seq_id] = false;
@@ -2730,9 +2759,7 @@ common_params common_base_params_to_speculative(const common_params & params) {
     result.n_outputs_max_per_seq = 1;
 
     // the MTP chain samples every step of a round in one decode
-    if (std::find(params.speculative.types.begin(), params.speculative.types.end(), COMMON_SPECULATIVE_TYPE_DRAFT_MTP) != params.speculative.types.end() &&
-            params.n_parallel == 1 && params_spec.probabilistic && params_spec.backend_sampling && params_spec.p_min <= 0.0f &&
-            params_spec.n_max >= 2 && params_spec.n_max <= LLAMA_MTP_CHAIN_MAX) {
+    if (params_spec.mtp_chain && params.n_parallel == 1 && params_spec.backend_sampling && params_spec.n_max > 1) {
         result.n_outputs_max = std::max(result.n_outputs_max, params_spec.n_max);
         result.n_outputs_max_per_seq = params_spec.n_max;
     }
diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index a301571e3..375579006 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -29,6 +29,7 @@
 #include <cassert>
 #include <cfloat>
 #include <cstdint>
+#include <cstdlib>
 #include <cstring>
 #include <cmath>
 #include <functional>
@@ -2044,9 +2045,12 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
                 const size_t row_bytes = ggml_row_size(src->type, src->ne[0]);
                 std::vector<uint8_t> rows(ggml_nbytes(draft_token_embd));
                 std::vector<int32_t> map(n_vocab, -1);
+                // negative control of the MTP chain identity test: every row holds its successor's embedding
+                static const bool shift = std::getenv("LLAMA_MTP_CHAIN_DEBUG_SHIFT_EMBD") != nullptr;
                 for (size_t i = 0; i < draft_vocab_ids.size(); ++i) {
                     void * dst = rows.data() + i * row_bytes;
-                    const void * row = ml.load_data_range(*weight, size_t(draft_vocab_ids[i]) * row_bytes, row_bytes, dst);
+                    const size_t i_src = shift ? (i + 1) % draft_vocab_ids.size() : i;
+                    const void * row = ml.load_data_range(*weight, size_t(draft_vocab_ids[i_src]) * row_bytes, row_bytes, dst);
                     if (row != dst) {
                         std::memcpy(dst, row, row_bytes);
                     }
diff --git a/src/llama-sampler.cpp b/src/llama-sampler.cpp
index 0786f3eaa..011a00c6f 100644
--- a/src/llama-sampler.cpp
+++ b/src/llama-sampler.cpp
@@ -1356,16 +1356,26 @@ static void llama_sampler_dist_backend_set_input(struct llama_sampler * smpl) {
 
     auto & rng = sctx->backend_transactional ? sctx->rng_backend : sctx->rng;
 
+    std::vector<float> rnds;
     for (auto * inp_uniform : sctx->inp_uniforms) {
         GGML_ASSERT(inp_uniform != nullptr);
 
-        const float rnd = dist(rng);
-        ggml_backend_tensor_set(inp_uniform, &rnd, 0, sizeof(float));
+        rnds.push_back(dist(rng));
 
         if (sctx->backend_transactional) {
             ++sctx->n_backend_draws_generated;
         }
     }
+
+    // negative control of the MTP chain identity test: hand the uniforms out in reverse order
+    static const bool reverse = std::getenv("LLAMA_MTP_CHAIN_DEBUG_REVERSE_U") != nullptr;
+    if (reverse) {
+        std::reverse(rnds.begin(), rnds.end());
+    }
+
+    for (size_t i = 0; i < rnds.size(); ++i) {
+        ggml_backend_tensor_set(sctx->inp_uniforms[i], &rnds[i], 0, sizeof(float));
+    }
 }
 
 static void llama_sampler_dist_backend_reset(struct llama_sampler * smpl) {
