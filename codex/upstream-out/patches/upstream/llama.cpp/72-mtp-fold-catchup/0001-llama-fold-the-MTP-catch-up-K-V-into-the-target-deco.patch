+static constexpr uint32_t mtp_fold_max_tokens = 64;
+
 //
 // llama_context
 //
@@ -1403,6 +1410,11 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
         ret = GGML_STATUS_FAILED;
