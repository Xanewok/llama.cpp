         /*.arch        =*/ model.arch,
         /*.hparams     =*/ model.hparams,
         /*.cparams     =*/ cparams,
@@ -2604,6 +2729,11 @@ llm_graph_params llama_context::graph_params(
         /*.cb          =*/ graph_get_cb(),
         /*.res         =*/ res,
     };
+
+    res_params.mctx_fold   = mctx_fold_cur;
+    res_params.fold_h_prev = mctx_fold_cur ? fold_h_cur : nullptr;
+
+    return res_params;
 }
 
 ggml_status llama_context::graph_compute(
@@ -4065,6 +4195,18 @@ float * llama_get_embeddings_nextn_ith(llama_context * ctx, int32_t i) {
     return ctx->get_embeddings_nextn_ith(i);
 }
 
+bool llama_mtp_fold_init(llama_context * ctx_tgt, llama_context * ctx_dft) {
+    return ctx_tgt->mtp_fold_init(ctx_dft);
+}
+
+void llama_mtp_fold_arm(llama_context * ctx_tgt, const float * h_prev) {
+    ctx_tgt->mtp_fold_arm(h_prev);
+}
+
+int32_t llama_mtp_fold_n_last(const llama_context * ctx_tgt) {
+    return ctx_tgt->mtp_fold_n_last();
+}
