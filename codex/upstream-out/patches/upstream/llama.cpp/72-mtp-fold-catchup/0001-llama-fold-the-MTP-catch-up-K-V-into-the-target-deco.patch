     auto * res = get_gf_res_prev();
     auto * gf  = res->get_gf();
@@ -1712,6 +1724,12 @@ static bool needs_raw_logits(const llama_ubatch & ubatch, const std::map<llama_s
 }
 
 int llama_context::decode(const llama_batch_ext & batch_inp) {
+
+    // an armed fold applies to this decode only, whatever its outcome
+    const float * fold_h = mtp_fold_h;
+    mtp_fold_h     = nullptr;
+    mtp_fold_n_tok = 0;
+
     if (!memory) {
         LLAMA_LOG_DEBUG("%s: cannot decode batches with this context (calling encode() instead)\n", __func__);
         return encode(batch_inp);
@@ -1866,6 +1884,17 @@ int llama_context::decode(const llama_batch_ext & batch_inp) {
         llama_sampler_backend_begin(entry.second);
     }
 
+    // MTP fold: one ubatch, one sequence, tokens only; every other batch keeps the draft's catch-up decode
+    llama_memory_context_ptr mctx_fold;
+    // (adapters would differ between the two contexts' MTP block)
+    if (fold_h && mtp_fold_dft && cparams.embeddings_nextn && !cparams.embeddings_nextn_masked && loras->empty()) {
+        const auto & ubatch = mctx->get_ubatch();
+        if (ubatch.n_tokens == n_tokens_all && ubatch.n_tokens <= mtp_fold_max_tokens &&
+                ubatch.token && !ubatch.embd && ubatch.n_seqs_unq == 1) {
+            mctx_fold = mtp_fold_dft->mtp_fold_prepare(ubatch);
+        }
+    }
+
     int64_t n_outputs_prev = 0;
     int64_t n_tokens_prev  = 0;
 
@@ -1890,8 +1919,14 @@ int llama_context::decode(const llama_batch_ext & batch_inp) {
 
         ggml_status status;
 
+        mctx_fold_cur = mctx_fold.get();
+        fold_h_cur    = fold_h;
+
         const auto * res = process_ubatch(ubatch, ctx_type_to_graph_type(cparams.ctx_type), mctx.get(), status);
 
+        mctx_fold_cur = nullptr;
+        fold_h_cur    = nullptr;
+
         if (!res) {
             // the last ubatch failed or was aborted -> remove all positions of that ubatch from the memory module
             llama_pos pos_min[LLAMA_MAX_SEQ];
@@ -1913,6 +1948,10 @@ int llama_context::decode(const llama_batch_ext & batch_inp) {
                 LLAMA_LOG_WARN("%s: removing memory module entries for seq_id = %d, pos = [%d, +inf)\n", __func__, s, pos_min[s]);
 
                 memory->seq_rm(s, pos_min[s], -1);
+
+                if (mctx_fold) {
+                    mtp_fold_dft->get_memory()->seq_rm(s, pos_min[s], -1);
+                }
             }
 
             switch (status) {
@@ -2055,6 +2094,10 @@ int llama_context::decode(const llama_batch_ext & batch_inp) {
         n_tokens_prev  += ubatch.n_tokens;
     } while (mctx->next());
 
+    if (mctx_fold) {
+        mtp_fold_n_tok = (int32_t) n_tokens_all;
+    }
