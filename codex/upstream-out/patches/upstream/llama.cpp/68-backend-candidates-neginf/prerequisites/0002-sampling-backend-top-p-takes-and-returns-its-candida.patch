From 2ea77c58e0dfe230b675246637cf4f4b1da5033e Mon Sep 17 00:00:00 2001
From: Igor Matuszewski <xanewok@gmail.com>
Date: Tue, 29 Sep 2026 23:44:14 +0200
Subject: [PATCH 02/15] sampling : backend top-p takes and returns its
 candidates flat

Backend top-p sorted the candidates with get_rows, which returns [1, n],
and asserted a single row on its input: top-k -> top-p -> top-p (or
top-p -> top-p) aborted while building the graph, even after top-k
returned its candidates flat. top-p now flattens the candidates it
receives, as #26270's review asked of each sampler (shape the input at
the start of apply), and hands them on flat.

tests : top_p_on_top_p compares top-k -> top-p -> top-p with the CPU chain
---
 src/llama-sampler.cpp          |  4 +++-
 tests/test-backend-sampler.cpp | 21 +++++++++++++++++++++
 2 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/src/llama-sampler.cpp b/src/llama-sampler.cpp
index 32de69da1..d093d5f1c 100644
--- a/src/llama-sampler.cpp
+++ b/src/llama-sampler.cpp
@@ -1662,8 +1662,10 @@ static void llama_sampler_top_p_backend_apply(
     ggml_set_name(softmax, "top_p_softmax");
 
     // If candidates are provided, sort them as well. Otherwise, set sorted indices as candidates.
+    // Flat in and out: an earlier sampler (top-k, top-p) may hand them over as [1, n]
     if (data->candidates) {
-        data->candidates = ggml_sort(data->candidates, sorted_idx);
+        struct ggml_tensor * candidates = ggml_reshape_1d(ctx, data->candidates, ggml_nelements(data->candidates));
+        data->candidates = ggml_reshape_1d(ctx, ggml_sort(candidates, sorted_idx), ggml_nelements(candidates));
     } else {
         data->candidates = sorted_idx;
     }
diff --git a/tests/test-backend-sampler.cpp b/tests/test-backend-sampler.cpp
index acdc2b5be..89122114e 100644
--- a/tests/test-backend-sampler.cpp
+++ b/tests/test-backend-sampler.cpp
@@ -2033,6 +2033,26 @@ static void test_backend_top_p_on_top_k_candidates(const test_params & params) {
     printf("backend top-p on top-k candidates test PASSED\n");
 }
 
+static void test_backend_top_p_on_top_p_candidates(const test_params & params) {
+    const std::string prompt = "Hello";
+    const std::vector<float> raw_logits = decode_raw_logits(params, prompt);
+
+    // each top-p after the first sorts the candidates of the one before it
+    const auto add_samplers = [](llama_sampler * chain) {
+        llama_sampler_chain_add(chain, llama_sampler_init_top_k(8));
+        llama_sampler_chain_add(chain, llama_sampler_init_top_p(0.99f, 1));
+        llama_sampler_chain_add(chain, llama_sampler_init_top_p(0.9f, 1));
+    };
+    const sampler_comparison_output output = run_sampler_comparison(
+            params, prompt, raw_logits, add_samplers, [](llama_sampler *) {});
+
+    const sampler_comparison_stats stats = compare_sampler_outputs(
+            "top_k + top_p + top_p", map_logits(output.expected), output.actual);
+    GGML_ASSERT(stats.n_mismatch == 0);
+
+    printf("backend top-p on top-p candidates test PASSED\n");
+}
+
 struct backend_test_case {
     std::string name;
     void (*fn)(const test_params &);
@@ -2061,6 +2081,7 @@ static const backend_test_case BACKEND_TESTS[] = {
     { "top_p",           test_backend_top_p_sampling,          true  },
     { "top_k_greedy",    test_backend_top_k_greedy_sampling,   true  },
     { "top_p_on_top_k",  test_backend_top_p_on_top_k_candidates, true },
+    { "top_p_on_top_p",  test_backend_top_p_on_top_p_candidates, true },
 };
 
 static test_args parse_cli(int argc, char ** argv) {
