#!/usr/bin/env python3
# Read the daemon snapshot without opening the queue's state lock.
import json
import sys
from pathlib import Path
if sys.argv[1:] != ['status', '--json']:
    raise SystemExit(2)
try:
    snapshot = json.loads(Path('/home/xanewok/.local/state/gpuq/status.json').read_text())
    print(json.dumps({'items': [{'kind': i.get('kind'), 'state': i['state']} for i in snapshot['items']]}))
except Exception:
    print(json.dumps({'items': [{'kind': 'measure', 'state': 'running'}]}))
