[arms.up]
label = "synchronous trace writer"
commit = "@COMMIT@"
root = "/home/xanewok/repos/qwen38-eval-worktrees/frozen/trace-writer"
bin = "build/bin"
repo = "/home/xanewok/repos/qwen38-eval-worktrees/wt/trace-writer"
exe = "build/bin/round-trace"
env = { GGML_ROUND_TRACE_SYNC = "1", GGML_CUDA_DEBUG_SSM_CONV = "1", GGML_SCHED_INPUT_STAGING = "1", LLAMA_ARG_LOG_VERBOSITY = "4", LLAMA_ARG_KV_PAD = "4096", LD_LIBRARY_PATH = "{root}/build/bin" }
flags = ["--kv-pad", "4096", "--spec-draft-type-k", "f16", "--spec-draft-type-v", "f16"]
canary_log = ["(?s)n_kv_pad += 4096\\b.*n_kv_pad += 4096\\b", "copy-engine H2D streams per GPU: 2\\b"]

[arms.patch]
label = "asynchronous trace writer"
commit = "@COMMIT@"
root = "/home/xanewok/repos/qwen38-eval-worktrees/frozen/trace-writer"
bin = "build/bin"
repo = "/home/xanewok/repos/qwen38-eval-worktrees/wt/trace-writer"
exe = "build/bin/round-trace"
env = { GGML_ROUND_TRACE_SYNC = "0", GGML_CUDA_DEBUG_SSM_CONV = "1", GGML_SCHED_INPUT_STAGING = "1", LLAMA_ARG_LOG_VERBOSITY = "4", LLAMA_ARG_KV_PAD = "4096", LD_LIBRARY_PATH = "{root}/build/bin" }
flags = ["--kv-pad", "4096", "--spec-draft-type-k", "f16", "--spec-draft-type-v", "f16"]
canary_log = ["(?s)n_kv_pad += 4096\\b.*n_kv_pad += 4096\\b", "copy-engine H2D streams per GPU: 2\\b"]

[server]
args = ["-m", "{model}", "-c", "102400", "-np", "1", "-fa", "on", "-ctk", "q8_0", "-ctv", "q8_0", "{arm_flags}",
        "-sm", "tensor", "--tensor-split", "50,50", "-ngl", "99", "-b", "2048", "-ub", "512",
        "--spec-type", "draft-mtp", "--spec-draft-n-max", "5", "--spec-draft-n-min", "0", "--spec-draft-p-min", "0",
        "--spec-draft-sampling", "probabilistic", "--spec-draft-backend-sampling", "--backend-sampling",
        "--spec-draft-vocab", "{draft_vocab}", "--cache-ram", "0", "--metrics", "-t", "8", "-tb", "8",
        "--host", "127.0.0.1", "--port", "{port}"]
knobs = ["GGML_SCHED_INPUT_STAGING", "LLAMA_ARG_LOG_VERBOSITY", "GGML_CUDA_AR_COPY_STREAMS", "GGML_CUDA_DEBUG_SSM_CONV", "GGML_META_AR_NODE", "GGML_CUDA_AR_NODE_SPIN_MS", "GGML_ROUND_TRACE_SYNC", "LLAMA_ROUND_TRACE", "GGML_SCHED_DEBUG"]

boot_cap_s = 300
request_cap_s = 600

[depth]
depths = [8192, 32768, 90112]
k = 5
identity = "cross-arm"
distinct_builds = false
min_steady_intervals = 40
min_predicted = 256
fixtures = "/home/xanewok/repos/qwen38-eval/orchestration/gpuq/fixtures"
counters = ["input", "input_api", "ar_call", "graph_hit", "input_fence_staged", "sampling"]
expected = { "8192" = -0.85, "32768" = -0.85, "90112" = -0.85 } # G, ms/round; no GPU result yet.
