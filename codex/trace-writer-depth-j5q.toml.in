[canary]
plan = ["up", "patch"]
depths = [8192]
proofs = []

[budget]
canary_s = 600
margin = 1.5
cleanup_s = 150
# G: 2300 s includes full run, both 8k canary arms, cleanup and contingency; reference full run = 1529 s (M).
# D: run budget ceil50(8 x 420 x 1.5 + 150) = 5200; total = 5200 + 600 + 150 = 5950 s.
# D: 8 x 420 = 3360 <= 0.7 x 5200 = 3640 s. Async median <= 0.1 ms is a G target; sync >= 0.3 ms proves the control.
est_s = 2300
startup_grace_s = 300
preflight_s = 300

[outputs]
